{
  "name": "ai-traffic-prediction",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack AI Traffic Prediction & Dynamic Route Optimization System",
  "scripts": {
    "start": "python run.py",
    "dev": "python run.py",
    "backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "python -m unittest discover -s tests -p \"test_*.py\"",
    "train": "python scripts/train_model.py"
  }
}
